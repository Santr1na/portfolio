# Скопируйте в файл .env в корне проекта: cp .env.example .env

# Если сайт открывается по префиксу (nginx location /site/ → proxy), укажите тот же префикс.
# Иначе ссылки на /images/… и CSS пойдут на корень домена, а не под /site/ — картинки «не достаются».
# APP_BASE_PATH=/site

# Дополнительные префиксы для маршрутов /…/images/* (через запятую), если nginx отдаёт путь без APP_BASE_PATH в .env:
# IMAGE_ASSET_BASES=/site

# nginx: proxy_set_header X-Forwarded-Prefix /site; (если префикс не в .env — для assetUrl на HTML)

PORT=3017
HOST=127.0.0.1
NODE_ENV=production

# Comma-separated secrets for cookie-session (use long random strings)
SESSION_SECRET=change-me-to-64-random-chars,second-key-optional

# scrypt hash — generate: npm run hash-admin -- 'YourPasswordHere'
ADMIN_PASSWORD_SCRYPT=

# Optional: salt for IP hashing in DB (change in production)
IP_HASH_SALT=

# Optional rate limits (defaults are sane for a small site)
# RATE_LIMIT_GLOBAL_MAX=400
# RATE_LIMIT_ASK_MAX=8
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_FEEDBACK_MAX=15

# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=g324.klokov.tpv_app
