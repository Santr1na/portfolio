<div class="shell narrow">
  <% if (thanks) { %>
  <div class="alert alert-success"><%= t('article_thanks') %></div>
  <% } %>
  <% if (errEmpty) { %>
  <div class="alert alert-error"><%= t('article_err_empty') %></div>
  <% } %>

  <article class="article-block panel article-hero">
    <p class="page-badge"><%= t('article_badge') %></p>
    <h1 class="page-h1 page-h1--gradient"><%= t('article_h1') %></h1>
    <div class="qa-card qa-card--q">
      <span class="qa-icon" aria-hidden="true">?</span>
      <div>
        <h2 class="panel-h2"><%= t('article_q') %></h2>
        <div class="qa-body"><% article.body.split(/\r?\n/).forEach(function (line) { %><p><%= line || ' ' %></p><% }) %></div>
      </div>
    </div>
    <div class="qa-card qa-card--a">
      <span class="qa-icon" aria-hidden="true">✓</span>
      <div>
        <h2 class="panel-h2"><%= t('article_a') %></h2>
        <div class="qa-body"><% (article.answer || '').split(/\r?\n/).forEach(function (line) { %><p><%= line || ' ' %></p><% }) %></div>
      </div>
    </div>
    <p class="muted meta-line"><%= t('article_published') %> <%= new Date(article.published_at).toLocaleString(typeof dateLocale !== 'undefined' ? dateLocale : 'en-GB') %></p>
  </article>

  <section class="panel review-panel">
    <% if (typeof feedbackStats !== 'undefined' && feedbackStats && feedbackStats.totalCount > 0) { %>
    <p class="muted article-stats-line">
      <% if (feedbackStats.ratingCount > 0) { %>
      <strong><%= t('article_stats_avg_short') %></strong> <%= feedbackStats.avgRating %> / 5 · <%= t('article_stats_ratings_n').replace('%s', String(feedbackStats.ratingCount)) %>
      <% } %>
      <% if (feedbackStats.totalCount > (feedbackStats.ratingCount || 0)) { %>
      <% if (feedbackStats.ratingCount > 0) { %> · <% } %><%= t('article_stats_total_n').replace('%s', String(feedbackStats.totalCount)) %>
      <% } %>
    </p>
    <% } %>
    <h2 class="panel-h2"><%= t('article_review_h') %></h2>
    <p class="muted"><%= t('article_review_p') %></p>
    <a class="btn btn-primary" href="<%= playUrl %>" target="_blank" rel="noopener noreferrer"><%= t('article_review_play') %></a>

    <h3 class="subh"><%= t('article_feedback_h') %></h3>
    <p class="muted small"><%= t('article_feedback_p') %></p>
    <form method="post" action="<%= appUrl('/q/' + article.slug + '/feedback') %>" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="hp-field" aria-hidden="true">
        <label for="company"><%= t('ask_hp_label') %></label>
        <input type="text" name="company" id="company" tabindex="-1" autocomplete="off">
      </div>
      <fieldset class="rating-row">
        <legend><%= t('article_rating_legend') %></legend>
        <% for (var r = 1; r <= 5; r++) { %>
        <label class="rating-opt"><input type="radio" name="rating" value="<%= r %>"> <span><%= r %></span></label>
        <% } %>
      </fieldset>
      <label class="field">
        <span><%= t('article_comment') %></span>
        <textarea name="comment" maxlength="1500" rows="4" placeholder="<%= t('article_comment_ph') %>"></textarea>
      </label>
      <button type="submit" class="btn btn-ghost"><%= t('article_feedback_btn') %></button>
    </form>
  </section>
</div>
