<div class="shell narrow page-intro">
  <header>
    <p class="page-badge"><%= t('delete_badge') %></p>
    <h1 class="page-h1 page-h1--gradient"><%= t('delete_title') %></h1>
    <p class="lead"><%= t('delete_lead') %></p>
  </header>

  <section class="panel" aria-labelledby="how-heading">
    <h2 id="how-heading" class="panel-h2"><%= t('delete_how_h') %></h2>
    <p class="muted"><%= t('delete_how_p') %></p>
    <ol class="steps">
      <li><div><%= t('delete_step1') %></div></li>
      <li><div><%= t('delete_step2') %></div></li>
      <li><div><%= t('delete_step3') %></div></li>
      <li><div><%= t('delete_step4') %></div></li>
    </ol>
  </section>

  <section class="panel" aria-labelledby="email-heading">
    <h2 id="email-heading" class="panel-h2"><%= t('delete_email_h') %></h2>
    <p class="muted"><%= t('delete_email_p') %></p>
    <a class="email-link" href="mailto:gamesearch16@gmail.com?subject=GameSearch%20account%20deletion%20request">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
      gamesearch16@gmail.com
    </a>
  </section>

  <section class="panel" aria-labelledby="data-heading">
    <h2 id="data-heading" class="panel-h2"><%= t('delete_data_h') %></h2>
    <p class="muted"><%= t('delete_data_p') %></p>
    <ul class="data-list">
      <li><%= t('delete_data_li1') %></li>
      <li><%= t('delete_data_li2') %></li>
      <li><%= t('delete_data_li3') %></li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="retention-heading">
    <h2 id="retention-heading" class="panel-h2"><%= t('delete_retention_h') %></h2>
    <p class="muted"><%= t('delete_retention_p1') %></p>
    <p class="muted retention-gap"><%= t('delete_retention_p2') %></p>
  </section>

  <section class="panel" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="panel-h2"><%= t('delete_contact_h') %></h2>
    <p class="muted"><%= t('delete_contact_p') %></p>
  </section>

  <p class="muted meta-line site-note"><%= t('delete_note') %></p>
</div>
