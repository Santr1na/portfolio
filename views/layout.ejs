<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#08060f">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= assetUrl('/styles.css') %>">
<title><%= title %> — GameSearch</title>
</head>
<body>
<div class="ambient" aria-hidden="true"></div>
<div class="ambient-glow" aria-hidden="true"></div>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= appUrl('/') %>">
      <span class="brand-mark brand-mark--logo" aria-hidden="true">
        <img src="<%= assetUrl('/images/ic_launcher_background.png') %>" alt="" width="84" height="84" decoding="async">
      </span>
      <span class="brand-text">Game<span class="brand-accent">Search</span></span>
    </a>
    <nav class="nav" aria-label="<%= t('layout_nav_aria') %>">
      <div class="nav-pills">
        <a href="<%= appUrl('/') %>" class="<%= path === '/' ? 'is-active' : '' %>"><%= t('nav_home') %></a>
        <a href="<%= appUrl('/ask') %>" class="<%= path === '/ask' ? 'is-active' : '' %>"><%= t('nav_ask') %></a>
        <a href="<%= appUrl('/delete-account') %>" class="<%= path === '/delete-account' ? 'is-active' : '' %>"><%= t('nav_delete') %></a>
      </div>
      <a class="nav-cta" href="<%= playUrl %>" target="_blank" rel="noopener noreferrer">
        <span class="nav-cta-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5zm13.81-5.38l6.42 3.54c.54.3 1.23.09 1.5-.45a10.1 10.1 0 0 0 0-9.42c-.27-.54-.96-.75-1.5-.45l-6.42 3.54zm-1.62-3.12L3.84 4.65A1.49 1.49 0 0 1 5.69 3l9.12 5.01-1.62 2.99z"/></svg>
        </span>
        <%= t('footer_play') %>
      </a>
    </nav>
  </div>
</header>
<main class="main-area">
<div class="page-wrap">
<%- body %>
</div>
</main>
<footer class="site-footer">
  <div class="site-footer-inner site-footer-inner--split">
    <div class="site-footer-row">
      <span>GameSearch</span>
      <span class="footer-dot" aria-hidden="true"></span>
      <a href="<%= playUrl %>" target="_blank" rel="noopener noreferrer"><%= t('footer_play') %></a>
    </div>
    <div class="lang-switch" role="navigation" aria-label="<%= t('lang_nav_aria') %>">
      <a href="<%= pageUrl('en', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'en' ? 'is-active' : '' %>">English</a>
      <span class="lang-switch-sep" aria-hidden="true">·</span>
      <a href="<%= pageUrl('ru', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'ru' ? 'is-active' : '' %>">Русский</a>
    </div>
  </div>
</footer>
<% if (typeof pageScripts !== 'undefined' && pageScripts && pageScripts.length) { %>
<% pageScripts.forEach(function (s) { %><script src="<%= s %>" defer></script><% }) %>
<% } %>
</body>
</html>
