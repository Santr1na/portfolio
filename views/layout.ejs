<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'ru' %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050308">
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'GameSearch — premium Android game catalog app.' %>">
<meta name="robots" content="index, follow">
<link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : appUrl('/') %>">

<meta property="og:type" content="website">
<meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'GameSearch — premium Android game catalog app.' %>">
<meta property="og:image" content="<%= assetUrl('/images/ic_launcher_background.png') %>">
<meta property="og:site_name" content="GameSearch">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %>">
<meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'GameSearch — premium Android game catalog app.' %>">
<meta name="twitter:image" content="<%= assetUrl('/images/ic_launcher_background.png') %>">

<link rel="icon" type="image/png" sizes="512x512" href="<%= assetUrl('/images/ic_launcher_background.png') %>">
<link rel="apple-touch-icon" href="<%= assetUrl('/images/ic_launcher_background.png') %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= assetUrl('/styles.css') %>">
<% if (typeof pageStyles !== 'undefined' && pageStyles && pageStyles.length) { %>
<% pageStyles.forEach(function (s) { %><link rel="stylesheet" href="<%= s %>"><% }) %>
<% } %>
<title><% if (typeof isHome !== 'undefined' && isHome && typeof ogTitle !== 'undefined') { %><%= ogTitle %><% } else { %><%= title %> — GameSearch<% } %></title>
</head>
<body class="<%= typeof isHome !== 'undefined' && isHome ? 'is-landing' : '' %>">
<div class="ambient" aria-hidden="true"></div>
<div class="ambient-glow" aria-hidden="true"></div>

<header class="topbar<%= typeof isHome !== 'undefined' && isHome ? ' topbar--landing' : '' %>" data-landing-nav>
  <div class="topbar-inner">
    <a class="brand" href="<%= appUrl('/') %>">
      <span class="brand-mark brand-mark--logo" aria-hidden="true">
        <img src="<%= assetUrl('/images/ic_launcher_background.png') %>" alt="" width="84" height="84" decoding="async">
      </span>
      <span class="brand-text">Game<span class="brand-accent">Search</span></span>
    </a>

    <% if (typeof isHome !== 'undefined' && isHome) { %>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-drawer" data-nav-toggle data-open-label="<%= t('nav_menu_open') %>" data-close-label="<%= t('nav_menu_close') %>">
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="sr-only" data-nav-toggle-label><%= t('nav_menu_open') %></span>
    </button>
    <div class="nav-drawer" id="nav-drawer" data-nav-drawer>
      <nav class="nav nav--landing" aria-label="<%= t('layout_nav_aria') %>">
        <div class="nav-links">
          <a href="#benefits" data-nav-link><%= t('nav_benefits') %></a>
          <a href="#features" data-nav-link><%= t('nav_features') %></a>
          <a href="#screenshots" data-nav-link><%= t('nav_screenshots') %></a>
          <a href="#how-it-works" data-nav-link><%= t('nav_how') %></a>
          <a href="#faq" data-nav-link><%= t('nav_faq') %></a>
          <a href="<%= appUrl('/review') %>"><%= t('nav_review') %></a>
          <a href="<%= appUrl('/ask') %>"><%= t('nav_ask') %></a>
        </div>
        <a class="nav-cta" href="<%= playUrl %>" target="_blank" rel="noopener noreferrer">
          <span class="nav-cta-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5zm13.81-5.38l6.42 3.54c.54.3 1.23.09 1.5-.45a10.1 10.1 0 0 0 0-9.42c-.27-.54-.96-.75-1.5-.45l-6.42 3.54zm-1.62-3.12L3.84 4.65A1.49 1.49 0 0 1 5.69 3l9.12 5.01-1.62 2.99z"/></svg>
          </span>
          <%= t('footer_play') %>
        </a>
      </nav>
    </div>
  </div>
    <% } else { %>
    <nav class="nav" aria-label="<%= t('layout_nav_aria') %>">
      <div class="nav-pills">
        <a href="<%= appUrl('/') %>" class="<%= path === '/' ? 'is-active' : '' %>"><%= t('nav_home') %></a>
        <a href="<%= appUrl('/review') %>" class="<%= path === '/review' ? 'is-active' : '' %>"><%= t('nav_review') %></a>
        <a href="<%= appUrl('/ask') %>" class="<%= path === '/ask' ? 'is-active' : '' %>"><%= t('nav_ask') %></a>
        <a href="<%= appUrl('/delete-account') %>" class="<%= path === '/delete-account' ? 'is-active' : '' %>"><%= t('nav_delete') %></a>
      </div>
      <a class="nav-cta" href="<%= playUrl %>" target="_blank" rel="noopener noreferrer">
        <span class="nav-cta-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85A1.5 1.5 0 0 1 3 20.5zm13.81-5.38l6.42 3.54c.54.3 1.23.09 1.5-.45a10.1 10.1 0 0 0 0-9.42c-.27-.54-.96-.75-1.5-.45l-6.42 3.54zm-1.62-3.12L3.84 4.65A1.49 1.49 0 0 1 5.69 3l9.12 5.01-1.62 2.99z"/></svg>
        </span>
        <%= t('footer_play') %>
      </a>
    </nav>
  </div>
    <% } %>
</header>

<main class="main-area<%= typeof isHome !== 'undefined' && isHome ? ' main-area--landing' : '' %>">
<% if (typeof isHome !== 'undefined' && isHome) { %>
<%- body %>
<% } else { %>
<div class="page-wrap">
<%- body %>
</div>
<% } %>
</main>

<% if (typeof isHome !== 'undefined' && isHome) { %>
<footer class="lp-footer">
  <div class="lp-container lp-footer__inner">
    <div class="lp-footer__brand">
      <a class="brand brand--footer" href="<%= appUrl('/') %>">
        <span class="brand-mark brand-mark--logo" aria-hidden="true">
          <img src="<%= assetUrl('/images/ic_launcher_background.png') %>" alt="" width="84" height="84" decoding="async">
        </span>
        <span class="brand-text">Game<span class="brand-accent">Search</span></span>
      </a>
      <p class="lp-footer__tagline"><%= t('footer_tagline') %></p>
    </div>
    <div class="lp-footer__cols">
      <div class="lp-footer__col">
        <h3 class="lp-footer__col-title"><%= t('footer_product') %></h3>
        <ul class="lp-footer__links">
          <li><a href="#features"><%= t('nav_features') %></a></li>
          <li><a href="#screenshots"><%= t('nav_screenshots') %></a></li>
          <li><a href="<%= playUrl %>" target="_blank" rel="noopener noreferrer"><%= t('footer_play') %></a></li>
        </ul>
      </div>
      <div class="lp-footer__col">
        <h3 class="lp-footer__col-title"><%= t('footer_support') %></h3>
        <ul class="lp-footer__links">
          <li><a href="<%= appUrl('/ask') %>"><%= t('nav_ask') %></a></li>
          <li><a href="<%= appUrl('/review') %>"><%= t('nav_review') %></a></li>
          <li><a href="#faq"><%= t('nav_faq') %></a></li>
        </ul>
      </div>
      <div class="lp-footer__col">
        <h3 class="lp-footer__col-title"><%= t('footer_legal') %></h3>
        <ul class="lp-footer__links">
          <li><a href="<%= appUrl('/delete-account') %>"><%= t('nav_delete') %></a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="lp-footer__bottom">
    <div class="lp-container lp-footer__bottom-inner">
      <p class="lp-footer__copy"><%= t('footer_copyright') %></p>
      <div class="lang-switch" role="navigation" aria-label="<%= t('lang_nav_aria') %>">
        <a href="<%= pageUrl('ru', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'ru' ? 'is-active' : '' %>">Русский</a>
        <span class="lang-switch-sep" aria-hidden="true">·</span>
        <a href="<%= pageUrl('en', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'en' ? 'is-active' : '' %>">English</a>
      </div>
    </div>
  </div>
</footer>
<% } else { %>
<footer class="site-footer">
  <div class="site-footer-inner site-footer-inner--split">
    <div class="site-footer-row">
      <span>GameSearch</span>
      <span class="footer-dot" aria-hidden="true"></span>
      <a href="<%= playUrl %>" target="_blank" rel="noopener noreferrer"><%= t('footer_play') %></a>
    </div>
    <div class="lang-switch" role="navigation" aria-label="<%= t('lang_nav_aria') %>">
      <a href="<%= pageUrl('ru', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'ru' ? 'is-active' : '' %>">Русский</a>
      <span class="lang-switch-sep" aria-hidden="true">·</span>
      <a href="<%= pageUrl('en', typeof langSwitcherPath !== 'undefined' ? langSwitcherPath : (path || '/')) %>" class="<%= lang === 'en' ? 'is-active' : '' %>">English</a>
    </div>
  </div>
</footer>
<% } %>

<% if (typeof pageScripts !== 'undefined' && pageScripts && pageScripts.length) { %>
<% pageScripts.forEach(function (s) { %><script src="<%= s %>" defer></script><% }) %>
<% } %>
</body>
</html>
