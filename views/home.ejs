<section class="hero hero--mesh">
  <div class="hero-head">
    <div class="hero-app-badge" aria-hidden="true">
      <img class="hero-app-logo-img" src="<%= assetUrl('/images/ic_launcher_background.png') %>" alt="" width="512" height="512" decoding="async">
    </div>
    <div class="hero-copy">
      <p class="page-badge"><%= t('home_badge_welcome') %></p>
      <h1 class="hero-title"><%= t('home_hero_title') %></h1>
      <p class="lead hero-lead"><%= t('home_hero_lead') %></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= playUrl %>" target="_blank" rel="noopener noreferrer"><%= t('home_btn_play') %></a>
        <a class="btn btn-ghost" href="<%= appUrl('/review') %>"><%= t('home_btn_review') %></a>
        <a class="btn btn-ghost" href="<%= appUrl('/ask') %>"><%= t('home_btn_ask') %></a>
      </div>
    </div>
  </div>
</section>

<section class="panel about-app">
  <h2 class="panel-title-inline"><%= t('home_about_h') %></h2>
  <div class="about-app-grid">
    <div class="about-app-main">
      <p class="lead about-lead"><%= t('home_about_p1') %></p>
      <p class="muted"><%= t('home_about_p2') %></p>
      <p class="muted"><%= t('home_about_p3') %></p>
    </div>
    <dl class="about-facts">
      <div><dt><%= t('home_fact_platform') %></dt><dd><%= t('home_fact_platform_val') %></dd></div>
      <div><dt><%= t('home_fact_ui') %></dt><dd><%= t('home_fact_ui_val') %></dd></div>
      <div><dt><%= t('home_fact_data') %></dt><dd><%= t('home_fact_data_val') %></dd></div>
      <div><dt><%= t('home_fact_site') %></dt><dd><%= t('home_fact_site_val') %></dd></div>
    </dl>
  </div>
</section>

<section class="panel features">
  <h2 class="panel-title-inline"><%= t('home_features_h') %></h2>
  <ul class="feature-grid">
    <li><%- t('home_feat_1') %></li>
    <li><%- t('home_feat_2') %></li>
    <li><%- t('home_feat_3') %></li>
    <li><%- t('home_feat_4') %></li>
  </ul>
</section>

<section class="panel carousel-card" aria-labelledby="shots-title">
  <p class="page-badge page-badge--tight"><%= t('home_shots_badge') %></p>
  <h2 id="shots-title" class="panel-title-inline"><%= t('home_shots_h') %></h2>
  <p class="muted carousel-intro"><%= t('home_shots_intro') %></p>
  <div class="carousel" data-carousel data-carousel-slide-prefix="<%= t('carousel_seg_prefix') %>" aria-roledescription="carousel" aria-label="<%= t('carousel_aria') %>">
    <div class="carousel-shell">
      <button type="button" class="carousel-fab carousel-prev" aria-controls="carousel-track" aria-label="<%= t('carousel_prev') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="carousel-fab carousel-next" aria-controls="carousel-track" aria-label="<%= t('carousel_next') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <div class="carousel-viewport" data-carousel-viewport>
        <ul class="carousel-track" id="carousel-track" role="list">
          <li class="carousel-slide is-active" data-caption="<%= t('carousel_cap_1') %>" data-caption-hint="<%= t('carousel_hint_1') %>">
            <img src="<%= assetUrl('/images/slide-1-profile.png') %>" alt="<%= t('carousel_alt_1') %>" width="1080" height="1920" loading="eager" decoding="async">
          </li>
          <li class="carousel-slide" data-caption="<%= t('carousel_cap_2') %>" data-caption-hint="<%= t('carousel_hint_2') %>">
            <img src="<%= assetUrl('/images/slide-2-news.png') %>" alt="<%= t('carousel_alt_2') %>" width="1080" height="1920" loading="lazy" decoding="async">
          </li>
          <li class="carousel-slide" data-caption="<%= t('carousel_cap_3') %>" data-caption-hint="<%= t('carousel_hint_3') %>">
            <img src="<%= assetUrl('/images/slide-3-favorites.png') %>" alt="<%= t('carousel_alt_3') %>" width="1080" height="1920" loading="lazy" decoding="async">
          </li>
          <li class="carousel-slide" data-caption="<%= t('carousel_cap_4') %>" data-caption-hint="<%= t('carousel_hint_4') %>">
            <img src="<%= assetUrl('/images/slide-4-collections.png') %>" alt="<%= t('carousel_alt_4') %>" width="1080" height="1920" loading="lazy" decoding="async">
          </li>
          <li class="carousel-slide" data-caption="<%= t('carousel_cap_5') %>" data-caption-hint="<%= t('carousel_hint_5') %>">
            <img src="<%= assetUrl('/images/slide-5-top-games.png') %>" alt="<%= t('carousel_alt_5') %>" width="1080" height="1920" loading="lazy" decoding="async">
          </li>
        </ul>
      </div>
    </div>
    <div class="carousel-meta">
      <p class="carousel-caption" id="carousel-caption" aria-live="polite"></p>
      <span class="carousel-counter" id="carousel-counter"></span>
    </div>
    <div class="carousel-progress" aria-hidden="true">
      <div class="carousel-progress-fill" id="carousel-progress-fill"></div>
    </div>
    <div class="carousel-segments" role="tablist" aria-label="<%= t('carousel_tabs_aria') %>"></div>
  </div>
</section>
